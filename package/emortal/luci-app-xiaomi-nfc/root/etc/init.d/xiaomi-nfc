#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	[ "$(uci -q get xiaomi_nfc.settings.enabled)" = 1 ] || return 0
	/usr/libexec/xiaomi-nfc sync || logger -t xiaomi-nfc 'NFC update failed'
}

reload_service() {
	start_service
}

service_triggers() {
	procd_add_reload_trigger wireless xiaomi_nfc
}
