#!/bin/sh /etc/rc.common

# Detect an usable NFC tag before LuCI builds its menu tree.
# A real CC-header read is required, not just the presence of /dev/i2c-N.
START=19

start() {
	local n cc bus='' attempt

	for attempt in 1 2 3; do
		for n in 0 1 2 3 4 5 6 7; do
			[ -c "/dev/i2c-$n" ] || continue
			cc=$(/usr/sbin/i2ctransfer -y "$n" w2@0x54 0x00 0x00 r4 2>/dev/null) || continue
			case "$cc" in
				'0xe1 0x43 0x80 0x09'|'0xe1 0x40 0x80 0x09') bus="$n"; break ;;
			esac
		done
		[ -n "$bus" ] && break
		sleep 1
	done

	if [ -n "$bus" ]; then
		uci -q set xiaomi_nfc.settings.bus="$bus"
		uci -q set xiaomi_nfc.settings.available='1'
	else
		uci -q set xiaomi_nfc.settings.available='0'
	fi
	uci -q commit xiaomi_nfc

	# menu.d depends on the UCI value; make sure LuCI does not serve a cached tree
	rm -f /tmp/luci-indexcache* /tmp/luci-modulecache/* 2>/dev/null
	return 0
}
