{
	"luci-app-xiaomi-control": {
		"description": "Grant access to Xiaomi fan, RGB lighting, NFC and RF mode control",
		"read": {
			"uci": [ "xiaomi-control", "be7000_radio", "wireless" ],
			"ubus": {
				"service": [ "list" ],
				"system": [ "board" ],
				"file": [ "read" ],
				"be7000.radio": [ "status" ]
			},
			"file": {
				"/var/run/xiaomi-control.json": [ "read" ],
				"/tmp/run/xiaomi-control.json": [ "read" ],
				"/var/run/xiaomi-nfc.json": [ "read" ],
				"/tmp/run/xiaomi-nfc.json": [ "read" ]
			}
		},
		"write": {
			"uci": [ "xiaomi-control", "be7000_radio" ],
			"ubus": {
				"be7000.radio": [ "set" ],
				"system": [ "reboot" ]
			}
		}
	}
}
