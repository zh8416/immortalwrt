#!/bin/sh

status=/var/run/fancontrol.status
[ -r "$status" ] || exit 0

temp_mc="$(awk -F= '$1 == "temperature_mc" { print $2; exit }' "$status")"
sensor="$(awk -F= '$1 == "hottest_sensor" { print $2; exit }' "$status")"
count="$(awk -F= '$1 == "sensor_count" { print $2; exit }' "$status")"

case "$temp_mc" in
	''|*[!0-9-]*) exit 0 ;;
esac
[ "$temp_mc" -ge 1000 ] 2>/dev/null || exit 0

awk -v temp="$temp_mc" -v sensor="$sensor" -v count="$count" 'BEGIN {
	printf "%.1f °C", temp / 1000
	if (sensor != "")
		printf " (%s", sensor
	if (count ~ /^[0-9]+$/ && count > 0)
		printf "%s%d sensors", sensor != "" ? ", " : " (", count
	if (sensor != "" || (count ~ /^[0-9]+$/ && count > 0))
		printf ")"
	printf "\n"
}'
