From: ViKing <viking.yfy@qq.com>
Date: Sat, 14 Nov 2026 22:30:36 +0800
Subject: [PATCH] phy: qcom: qmp-usb: program IPQ fastlock gain in RX bank

The IPQ8074 and IPQ9574 SerDes tables contain a receiver register. Table
entries are relative to the selected bank, so its 0x40 offset writes
QSERDES_COM_SYSCLK_BUF_ENABLE instead of the RX fastlock gain at 0x440.
The receiver keeps its reset value while the common clock buffer is
unintentionally changed.

Move the entry into the corresponding RX tables, preserving its existing
value and the common clock buffer reset value. IPQ6018 and IPQ5424 reuse
these tables and need the same correction.

Signed-off-by: ViKing <viking.yfy@qq.com>

--- a/drivers/phy/qualcomm/phy-qcom-qmp-usb.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-usb.c
@@ -114,7 +114,6 @@
 	QMP_PHY_INIT_CFG(QSERDES_COM_BIAS_EN_CLKBUFLR_EN, 0x08),
 	QMP_PHY_INIT_CFG(QSERDES_COM_CLK_SELECT, 0x30),
 	QMP_PHY_INIT_CFG(QSERDES_COM_BG_TRIM, 0x0f),
-	QMP_PHY_INIT_CFG(QSERDES_RX_UCDR_FASTLOCK_FO_GAIN, 0x0b),
 	QMP_PHY_INIT_CFG(QSERDES_COM_SVS_MODE_CLK_SEL, 0x01),
 	QMP_PHY_INIT_CFG(QSERDES_COM_HSCLK_SEL, 0x00),
 	QMP_PHY_INIT_CFG(QSERDES_COM_CMN_CONFIG, 0x06),
@@ -153,6 +152,7 @@
 };
 
 static const struct qmp_phy_init_tbl ipq9574_usb3_rx_tbl[] = {
+	QMP_PHY_INIT_CFG(QSERDES_RX_UCDR_FASTLOCK_FO_GAIN, 0x0b),
 	QMP_PHY_INIT_CFG(QSERDES_RX_UCDR_SO_GAIN, 0x06),
 	QMP_PHY_INIT_CFG(QSERDES_RX_RX_EQU_ADAPTOR_CNTRL2, 0x02),
 	QMP_PHY_INIT_CFG(QSERDES_RX_RX_EQU_ADAPTOR_CNTRL3, 0x6c),
@@ -196,7 +196,6 @@
 	QMP_PHY_INIT_CFG(QSERDES_COM_BIAS_EN_CLKBUFLR_EN, 0x08),
 	QMP_PHY_INIT_CFG(QSERDES_COM_CLK_SELECT, 0x30),
 	QMP_PHY_INIT_CFG(QSERDES_COM_BG_TRIM, 0x0f),
-	QMP_PHY_INIT_CFG(QSERDES_RX_UCDR_FASTLOCK_FO_GAIN, 0x0b),
 	QMP_PHY_INIT_CFG(QSERDES_COM_SVS_MODE_CLK_SEL, 0x01),
 	QMP_PHY_INIT_CFG(QSERDES_COM_HSCLK_SEL, 0x00),
 	QMP_PHY_INIT_CFG(QSERDES_COM_CMN_CONFIG, 0x06),
@@ -229,6 +228,7 @@
 };
 
 static const struct qmp_phy_init_tbl ipq8074_usb3_rx_tbl[] = {
+	QMP_PHY_INIT_CFG(QSERDES_RX_UCDR_FASTLOCK_FO_GAIN, 0x0b),
 	QMP_PHY_INIT_CFG(QSERDES_RX_UCDR_SO_GAIN, 0x06),
 	QMP_PHY_INIT_CFG(QSERDES_RX_RX_EQU_ADAPTOR_CNTRL2, 0x02),
 	QMP_PHY_INIT_CFG(QSERDES_RX_RX_EQU_ADAPTOR_CNTRL3, 0x4c),
