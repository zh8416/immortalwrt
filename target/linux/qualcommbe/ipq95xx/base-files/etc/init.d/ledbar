#!/bin/sh /etc/rc.common
# Light bar effects service. Disabled by default: nothing changes until enabled.
. /lib/functions.sh

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load ledbar
	local enabled effect r g b delay
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0
	config_get effect main effect breath
	config_get r main red 0
	config_get g main green 128
	config_get b main blue 255
	config_get delay main delay 0.04

	case "$effect" in
		breath|blink|rainbow)
			procd_open_instance
			procd_set_param command /usr/sbin/ledbar "$effect" "$r" "$g" "$b" "$delay"
			procd_set_param respawn 3600 5 5
			procd_close_instance
			;;
		static|on) /usr/sbin/ledbar static "$r" "$g" "$b" ;;
		off)       /usr/sbin/ledbar off ;;
	esac
}

stop_service() { /usr/sbin/ledbar off 2>/dev/null; }
service_triggers() { procd_add_reload_trigger ledbar; }
